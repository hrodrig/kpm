# Whitelist .gitignore — ignore everything, then re-allow explicitly.
*
!*/

# Project config and docs
!/.gitignore
!AGENTS.md
!SPECIFICATIONS.md
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!SECURITY.md
!LICENSE
!VERSION
!go.mod
!go.sum
!GNUmakefile
!Makefile
!.golangci.yml
!.goreleaser.yaml
!.govulncheck-ignore.yaml
!.grype.yaml
!Dockerfile
!Dockerfile.release
!.dockerignore

# Source
!cmd/
!cmd/**
!internal/
!internal/**
!configs/
!configs/**

# Packaging
!contrib/
!contrib/**
!docs/
!docs/**

# CI
!.github/
!.github/**

# Never commit these
.planning/
**/.DS_Store
# Generated when lint builds the man pages (!contrib/** un-ignores them)
contrib/man/man1/*.gz
